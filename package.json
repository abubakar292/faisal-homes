    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.77.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.11.0",
    "zod": "^3.25.76"

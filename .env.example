# ---- FAISAL HOMES configuration (Supabase + Vercel) ----
# Copy this file to .env for local development. On Vercel, enter the same names under
# Project → Settings → Environment Variables. Never commit the real .env file.

# Supabase → Project Settings → API (or the "Connect" button)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable / anon key (public: it is also sent to the browser for sign-in)
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Secret / service_role key (SECRET: server only. Used to create staff logins and to store documents)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_OR_SERVICE_ROLE_KEY
# Optional, only for projects still using the legacy JWT secret (Project Settings → JWT Keys)
# SUPABASE_JWT_SECRET=

# Database: Supabase → Connect → "Transaction pooler" connection string (port 6543), with your database password.
# Special characters in the password must be URL-encoded (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Optional: paste the Supabase SSL certificate (Database Settings → SSL Configuration) to verify the server identity.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

APP_TIMEZONE=Asia/Karachi
MAX_UPLOAD_MB=10
# Local development only
PORT=4000

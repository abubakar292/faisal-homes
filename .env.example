# ---- FAISAL HOMES configuration ----
# PostgreSQL connection (change the password!)
DATABASE_URL=postgres://postgres:YOUR_DB_PASSWORD@localhost:5432/faisal_homes
PORT=4000
HOST=0.0.0.0
APP_TIMEZONE=Asia/Karachi

# Where uploaded documents and backups are stored (relative to this folder or absolute)
STORAGE_DIR=storage
# BACKUP_DIR=storage/backups
# Optional second copy of every backup, e.g. a Google Drive / OneDrive synced folder or USB drive:
# BACKUP_COPY_DIR=G:\My Drive\FaisalHomesBackups

# Folder containing pg_dump / pg_restore if they are not on PATH (Windows example):
# PG_BIN_DIR=C:\Program Files\PostgreSQL\16\bin

# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false
MAX_UPLOAD_MB=10
